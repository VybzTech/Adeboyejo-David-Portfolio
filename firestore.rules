rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects collection — public read, authenticated write (admin CMS)
    match /projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact form submissions — anyone can write, only authenticated admins can read
    match /contact_inquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Interaction telemetry — anyone can write (fire-and-forget), admins can read
    match /interaction_log/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
